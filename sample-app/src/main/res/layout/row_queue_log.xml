<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/queue_request_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3C2A00"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/queue_event_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#6E5A1A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/queue_attempts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#6E5A1A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/queue_queued_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#6E5A1A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/queue_created_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#6E5A1A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/queue_payload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#3C2A00"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:typeface="monospace" />
</LinearLayout>
