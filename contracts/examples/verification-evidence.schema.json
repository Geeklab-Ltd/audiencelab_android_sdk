{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Geeklab-Ltd/audiencelab_android_sdk/contracts/examples/verification-evidence.schema.json",
  "title": "Audiencelab Android Integration Verification Evidence",
  "description": "Machine-checkable evidence envelope produced by an agent after integrating the native Android SDK (GEE-518).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_schema_version",
    "contract_id",
    "contract_version",
    "package_sdk_version",
    "generated_at",
    "environment",
    "local",
    "runtime",
    "backend",
    "secrets",
    "checks",
    "result"
  ],
  "properties": {
    "evidence_schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "const": "audiencelab.android.native.integration"
    },
    "contract_version": {
      "type": "string"
    },
    "package_sdk_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": ["sandbox", "production"]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application_id": { "type": "string" },
        "app_version": { "type": "string" },
        "min_sdk": { "type": "integer" },
        "target_sdk": { "type": "integer" }
      }
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_maven_coordinate",
        "sdk_version_runtime",
        "manifest_permissions",
        "secret_storage_mechanism",
        "vcs_secret_scan_passed"
      ],
      "properties": {
        "resolved_maven_coordinate": { "type": "string" },
        "sdk_version_runtime": { "type": "string" },
        "manifest_permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secret_storage_mechanism": { "type": "string" },
        "vcs_secret_scan_passed": { "type": "boolean" },
        "install_method": {
          "type": "string",
          "enum": ["gradle_github_packages", "manual_aar"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialize_returned_true",
        "is_initialized",
        "token",
        "signals_emitted",
        "runtime_errors"
      ],
      "properties": {
        "initialize_returned_true": { "type": "boolean" },
        "is_initialized": { "type": "boolean" },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_valid_token", "last_fetch_status", "creative_token_preview"],
          "properties": {
            "has_valid_token": { "type": "boolean" },
            "last_fetch_status": { "type": "string" },
            "creative_token_preview": { "type": "string" },
            "attempt_count": { "type": "integer" }
          }
        },
        "signals_emitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "accepted_locally"],
            "properties": {
              "id": { "type": "string" },
              "accepted_locally": { "type": "boolean" },
              "queue_size_after": { "type": "integer" }
            }
          }
        },
        "runtime_errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "identity_settled": { "type": "boolean" },
        "api_key_preview": { "type": "string" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "accepted_signal_count",
        "freshness_ok",
        "blocking_failures"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["sandbox", "production"]
        },
        "accepted_signal_count": { "type": "integer", "minimum": 0 },
        "freshness_ok": { "type": "boolean" },
        "blocking_failures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_state": {
          "type": "string",
          "enum": [
            "not_started",
            "integrating",
            "blocked",
            "signal_received",
            "analysis_ready",
            "unknown"
          ]
        },
        "observation_source": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_api_key_present", "raw_creative_token_present"],
      "properties": {
        "raw_api_key_present": {
          "type": "boolean",
          "description": "Must be false. Detector flag for accidental secret inclusion."
        },
        "raw_creative_token_present": {
          "type": "boolean",
          "description": "Must be false. Detector flag for accidental secret inclusion."
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passed"],
        "properties": {
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
