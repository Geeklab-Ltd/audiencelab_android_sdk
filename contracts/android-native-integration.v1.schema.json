{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Geeklab-Ltd/audiencelab_android_sdk/contracts/android-native-integration.v1.schema.json",
  "title": "Audiencelab Android Native Integration Contract",
  "description": "Machine-readable contract for agent-driven native Android Audiencelab SDK integration and certification (GEE-518).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "platform",
    "status",
    "authority",
    "package",
    "compatibility",
    "install",
    "manifest",
    "credentials",
    "initialization",
    "required_signals",
    "consent",
    "diagnostics",
    "verification",
    "rollback",
    "out_of_scope",
    "references"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "audiencelab.android.native.integration"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "type": "string",
      "const": "android_native"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "deprecated"]
    },
    "issued_at": {
      "type": "string",
      "format": "date"
    },
    "linear_issue": {
      "type": "string"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_issue", "credential_policy", "readiness_definition"],
      "properties": {
        "approval_issue": { "type": "string" },
        "credential_policy": { "type": "string" },
        "readiness_definition": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maven_coordinates",
        "sdk_version",
        "release_tag",
        "aar_asset",
        "repository_url",
        "github_packages_url",
        "public_api_root"
      ],
      "properties": {
        "maven_group_id": { "type": "string" },
        "maven_artifact_id": { "type": "string" },
        "maven_coordinates": { "type": "string" },
        "sdk_version": { "type": "string" },
        "release_tag": { "type": "string" },
        "aar_asset": { "type": "string" },
        "repository_url": { "type": "string", "format": "uri" },
        "github_packages_url": { "type": "string", "format": "uri" },
        "public_api_root": { "type": "string" },
        "default_base_url": { "type": "string", "format": "uri" },
        "endpoints": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_sdk", "target_sdk", "languages", "build_systems"],
      "properties": {
        "min_sdk": { "type": "integer", "minimum": 1 },
        "target_sdk": { "type": "integer", "minimum": 1 },
        "languages": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "build_systems": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "steps", "fallbacks"],
      "properties": {
        "recommended": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "required", "actions"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "required": { "type": "boolean" },
              "actions": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "actions"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "actions": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_permissions", "optional_permissions", "notes"],
      "properties": {
        "required_permissions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional_permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_name",
        "delivery",
        "storage",
        "forbidden",
        "environments",
        "inspection"
      ],
      "properties": {
        "secret_name": { "type": "string" },
        "delivery": { "type": "string" },
        "storage": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "environments": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "inspection": {
          "type": "array",
          "items": { "type": "string" }
        },
        "api_preview_method": { "type": "string" }
      }
    },
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoints", "required_options", "timing"],
      "properties": {
        "entrypoints": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "required_options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional_options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timing": { "type": "string" },
        "success_predicate": { "type": "string" }
      }
    },
    "required_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "minimum_for_certification", "recommended"],
      "properties": {
        "automatic": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" }
        },
        "minimum_for_certification": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" },
          "minItems": 1
        },
        "recommended": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "rules", "identity_controls"],
      "properties": {
        "model": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "identity_controls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hashed_blacklisted_keys": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apis", "safe_logging_rules"],
      "properties": {
        "apis": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "purpose"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "returns": { "type": "string" }
            }
          },
          "minItems": 1
        },
        "safe_logging_rules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_schema_version",
        "local_checks",
        "runtime_checks",
        "backend_checks",
        "pass_criteria"
      ],
      "properties": {
        "evidence_schema_version": { "type": "string" },
        "local_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" },
          "minItems": 1
        },
        "runtime_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" },
          "minItems": 1
        },
        "backend_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "pass_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "evidence_output_path": { "type": "string" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "compatibility_notes"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "compatibility_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs", "linear"],
      "properties": {
        "docs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "linear": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "how", "required_fields"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["automatic", "app_emitted", "optional"]
        },
        "how": { "type": "string" },
        "required_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "evidence_fields", "pass_when"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "evidence_fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "pass_when": { "type": "string" },
        "blocking": { "type": "boolean", "default": true }
      }
    }
  }
}
