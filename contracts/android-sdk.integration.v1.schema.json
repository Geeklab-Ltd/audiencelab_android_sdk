{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Geeklab-Ltd/audiencelab_android_sdk/contracts/android-sdk.integration.v1.schema.json",
  "title": "Audiencelab Android SDK Integration Contract",
  "description": "Schema for the agent-verifiable native Android integration contract (GEE-518).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "schema_ref",
    "issue_refs",
    "platform",
    "status",
    "sdk",
    "install_steps",
    "public_api",
    "credentials",
    "required_signals",
    "privacy_and_consent",
    "diagnostics",
    "rollback",
    "verification",
    "out_of_scope",
    "human_docs"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "audiencelab.android_sdk.integration"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_ref": { "type": "string" },
    "issue_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "platform": {
      "type": "string",
      "const": "native_android"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "deprecated"]
    },
    "published_at": { "type": "string" },
    "summary": { "type": "string" },
    "sdk": {
      "type": "object",
      "required": [
        "product_name",
        "module_name",
        "sdk_type",
        "version",
        "version_tag",
        "maven_coordinates",
        "min_sdk",
        "repository",
        "distribution"
      ],
      "properties": {
        "product_name": { "type": "string" },
        "module_name": { "type": "string" },
        "public_api_root": { "type": "string" },
        "sdk_type": { "type": "string", "const": "native_android" },
        "version": { "type": "string" },
        "version_tag": { "type": "string" },
        "maven_coordinates": { "type": "string" },
        "maven_group_id": { "type": "string" },
        "maven_artifact_id": { "type": "string" },
        "min_sdk": { "type": "integer" },
        "target_sdk": { "type": "integer" },
        "default_base_url": { "type": "string" },
        "endpoints": { "type": "object", "additionalProperties": { "type": "string" } },
        "api_key_header": { "type": "string" },
        "repository": { "type": "object" },
        "version_sources": { "type": "array" },
        "distribution": { "type": "array", "minItems": 1 }
      }
    },
    "install_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "required"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer" },
          "title": { "type": "string" },
          "required": { "type": "boolean" },
          "details": { "type": "array", "items": { "type": "string" } },
          "preferred_method": { "type": "string" },
          "methods": { "type": "object" },
          "code_ref": { "type": "string" },
          "api": { "type": "string" },
          "command": { "type": "string" },
          "evidence_path": { "type": "string" }
        }
      }
    },
    "public_api": { "type": "object" },
    "credentials": {
      "type": "object",
      "required": ["kind", "header_name", "environments", "handoff", "injection"],
      "properties": {
        "kind": { "type": "string" },
        "header_name": { "type": "string" },
        "environments": { "type": "array", "items": { "type": "string" } },
        "handoff": { "type": "object" },
        "injection": { "type": "object" },
        "production_gate": { "type": "string" }
      }
    },
    "required_signals": { "type": "object" },
    "privacy_and_consent": { "type": "object" },
    "diagnostics": { "type": "object" },
    "rollback": {
      "type": "object",
      "required": ["required", "steps"],
      "properties": {
        "required": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1 },
        "evidence_after_rollback": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification": { "type": "object" },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "phase": { "type": "integer" },
          "issue": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "human_docs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "compatibility": { "type": "object" }
  }
}
